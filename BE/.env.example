NODE_ENV=development
PORT=8000
MONGO_URL=mongodb://127.0.0.1:27017/ap-post

# Authentication (use independent, long random secrets)
JWT_ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_TOKEN=replace_with_a_different_32_character_secret
JWT_REFRESH_EXPIRE=7d

# Browser and public URLs
CORS_ORIGINS=http://localhost:4200,https://ap-post.vercel.app
FRONTEND_URL=http://localhost:4200
PUBLIC_APP_URL=http://localhost:4200
API_BASE_URL=http://localhost:8000/api/v1
SWAGGER_ENABLED=true

# Initial data (disable after first successful seed)
SHOULD_INIT=false
INIT_PASSWORD=replace_with_a_strong_seed_password

# ==================== BREVO (Email Delivery) ====================
# Sign up at https://www.brevo.com/ to get your API key
# BREVO_API_KEY is required for sending emails
BREVO_API_KEY=
# Verified sender email and name (must be configured in Brevo admin)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AP Post

SUPPORT_EMAIL=support@ap-post.vn
SUPPORT_PHONE=0908779245

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# MoMo (optional)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_CONFIRM_ON_RETURN=true

# VNPAY (optional; fill all three credential fields together)
# Sandbox endpoint: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ORDER_INFO=AP Post payment
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
VNPAY_CURRENCY=VND
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Browser return endpoint. The production value must use the public HTTPS API URL.
VNPAY_RETURN_URL=http://localhost:8000/api/v1/payment/vnpay/return
# Configure this URL in the VNPAY merchant portal (VNPAY sends IPN via GET).
VNPAY_IPN_URL=http://localhost:8000/api/v1/payment/vnpay/ipn
# Local sandbox only. Production must keep this false and use the VNPAY IPN URL.
VNPAY_CONFIRM_ON_RETURN=true

# Public B2C OTP controls
B2C_OTP_COOLDOWN_SECONDS=60
B2C_OTP_MAX_PER_30M=5

# Shipper operations
# Time allowed for a shipper to accept/reject a dispatch offer.
SHIPPER_ASSIGNMENT_RESPONSE_MINUTES=15
# A presence older than this is treated as offline (protects against server/device crashes).
SHIPPER_PRESENCE_TTL_MS=90000
SHIPPER_DISPATCH_MODE=MANUAL
SHIPPER_AUTO_ASSIGN_ONLINE_ONLY=true
SHIPPER_MAX_ACTIVE_JOBS=20
SHIPPER_MOTORBIKE_MAX_WEIGHT_KG=30
SHIPPER_CAR_MAX_WEIGHT_KG=300
SHIPPER_VAN_MAX_WEIGHT_KG=1000
SHIPPER_MAX_DELIVERY_ATTEMPTS=3
SHIPPER_REQUIRE_DELIVERY_PROOF=true
