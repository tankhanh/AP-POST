PORT=8000
MONGO_URL=your_mongodb_connection_string

# setup access token
JWT_ACCESS_TOKEN_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRE=1000m

# setup refresh token
JWT_REFRESH_TOKEN=your_refresh_token_secret
JWT_REFRESH_EXPIRE=1d

# init sample data
SHOULD_INIT=true
INIT_PASSWORD=your_init_password

# config email
EMAIL_HOST=smtp.gmail.com
EMAIL_AUTH_USER=your_email@gmail.com
EMAIL_AUTH_PASS=your_email_app_password
EMAIL_PREVIEW=true

# comma-separated allowlist origins
CORS_ORIGINS=http://localhost:4200,https://ap-post.vercel.app

# used in email tracking link generation
PUBLIC_APP_URL=http://localhost:4200

# B2C OTP hardening
B2C_OTP_COOLDOWN_SECONDS=60
B2C_OTP_MAX_PER_30M=5
